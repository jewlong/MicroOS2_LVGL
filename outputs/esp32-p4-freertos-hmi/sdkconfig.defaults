# Target SoC: ESP32-P4 (Dual-Core 400 MHz RISC-V + PPA 2D Accelerator)
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Flash (16 MB QIO) & Custom Partition Table
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# External PSRAM (16 MB / 32 MB Hex/Octal SPIRAM)
# Allows VGP_BSS_ATTR (EXT_RAM_BSS_ATTR) to place large ViewGP static structures in PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# FreeRTOS (1000 Hz tick, SMP dual-core)
CONFIG_FREERTOS_HZ=1000

# HTTP Server (allow X-Ops-Token + Content-Length headers)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# LVGL 9 Configuration for ViewGP Core
CONFIG_LV_OS_NONE=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=2048
CONFIG_LV_USE_CLIB_MALLOC=n
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_USE_DRAW_PPA=y
